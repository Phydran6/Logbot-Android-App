<?xml version="1.0" encoding="utf-8"?>
<!--
    Datei:       activity_main.xml
    Projekt:     Logbot
    Autor:       Phydran6
    Version:     1.0 - 05.04.2026.15.44.55

    Beschreibung:
    Haupt-Layout der App. Enthält ausschließlich eine WebView, die den gesamten
    Bildschirm ausfüllt. Die WebView lädt die Logbot-Weboberfläche.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
        WebView: Füllt den gesamten Bildschirm aus.
        ID "webview" wird in MainActivity verwendet, um die View zu referenzieren.
    -->
    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
        Dezenter Versions-Overlay unten rechts. Default-TextView ist nicht
        clickable/focusable, blockiert also keine Touches an der WebView.
        Weißer Text mit Drop-Shadow ist auf hellen wie dunklen Web-UIs lesbar.
    -->
    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="6dp"
        android:padding="2dp"
        android:textSize="9sp"
        android:textColor="#99FFFFFF"
        android:shadowColor="#88000000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="3"
        android:fontFamily="monospace" />

</FrameLayout>
